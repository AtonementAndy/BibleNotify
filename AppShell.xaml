<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BibleNotify.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:BibleNotify.Localization"
    Title="BibleNotify"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}">

    <ShellContent
        x:Name="LoginContent"
        Route="login"
        Shell.NavBarIsVisible="False" />

    <TabBar
        Route="main"
        Shell.TabBarIsVisible="False"
        Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
        Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
        Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
        Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
        <ShellContent
            x:Name="HomeContent"
            Title="{localization:Translate Key='Início'}"
            Route="home" />
        <ShellContent
            x:Name="ReadingPlanContent"
            Title="{localization:Translate Key='Planos'}"
            Route="plans" />
        <ShellContent
            x:Name="BibleContent"
            Title="{localization:Translate Key='Bíblia'}"
            Route="bible" />
        <ShellContent
            x:Name="NotesContent"
            Title="{localization:Translate Key='Anotações'}"
            Route="notes" />
        <ShellContent
            x:Name="SettingsContent"
            Title="{localization:Translate Key='Ajustes'}"
            Route="settings" />
    </TabBar>

</Shell>
