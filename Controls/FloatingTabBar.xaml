<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="BibleNotify.Controls.FloatingTabBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:acrylic="clr-namespace:Xe.AcrylicView;assembly=Xe.AcrylicView"
    xmlns:localization="clr-namespace:BibleNotify.Localization"
    HeightRequest="84"
    Padding="12,4"
    BackgroundColor="Transparent">

    <acrylic:AcrylicView Style="{StaticResource AcrylicTabBar}" Padding="8">
        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
            <Border
                Grid.Column="0"
                Padding="4"
                Shadow="{x:Null}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="home">
                        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="{AppThemeBinding Light=nav_home_light.svg, Dark=nav_home.svg}" WidthRequest="24" HeightRequest="24" Opacity="1">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="home">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Source" Value="nav_home.svg" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="{localization:Translate Key='Início'}" FontSize="9" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="home">
                                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="1"
                Padding="4"
                Shadow="{x:Null}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="plans">
                        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlansTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="{AppThemeBinding Light=nav_plans_light.svg, Dark=nav_plans.svg}" WidthRequest="22" HeightRequest="22" Opacity="0.82">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="plans">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Source" Value="nav_plans.svg" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="{localization:Translate Key='Planos'}" FontSize="9" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="plans">
                                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="2"
                Padding="4"
                Shadow="{x:Null}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="bible">
                        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBibleTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="{AppThemeBinding Light=nav_bible_light.svg, Dark=nav_bible.svg}" WidthRequest="22" HeightRequest="22" Opacity="0.82">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="bible">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Source" Value="nav_bible.svg" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="{localization:Translate Key='Bíblia'}" FontSize="9" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="bible">
                                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="3"
                Padding="4"
                Shadow="{x:Null}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="notes">
                        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotesTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="{AppThemeBinding Light=nav_notes_light.svg, Dark=nav_notes.svg}" WidthRequest="22" HeightRequest="22" Opacity="0.82">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="notes">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Source" Value="nav_notes.svg" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="{localization:Translate Key='Notas'}" FontSize="9" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="notes">
                                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="4"
                Padding="4"
                Shadow="{x:Null}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="settings">
                        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="{AppThemeBinding Light=nav_settings_light.svg, Dark=nav_settings.svg}" WidthRequest="22" HeightRequest="22" Opacity="0.82">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="settings">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Source" Value="nav_settings.svg" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="{localization:Translate Key='Ajustes'}" FontSize="9" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedTab, Source={x:Reference Root}}" Value="settings">
                                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </acrylic:AcrylicView>
</ContentView>
