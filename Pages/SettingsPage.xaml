<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BibleNotify.Pages.SettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:acrylic="clr-namespace:Xe.AcrylicView;assembly=Xe.AcrylicView"
    xmlns:controls="clr-namespace:BibleNotify.Controls"
    xmlns:localization="clr-namespace:BibleNotify.Localization"
    xmlns:models="clr-namespace:BibleNotify.Data.Models"
    xmlns:vm="clr-namespace:BibleNotify.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="{localization:Translate Key='Ajustes'}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="*,Auto"
          Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="20,20,20,28" Spacing="20">
            <VerticalStackLayout IsVisible="{Binding IsMenu}" Spacing="4">
                <Label
                    Text="{Binding AccountStatus}"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Label
                    Text="{Binding SectionTitle}"
                    FontFamily="OpenSansSemibold"
                    FontSize="30"
                    SemanticProperties.HeadingLevel="Level1" />
            </VerticalStackLayout>
            <Grid IsVisible="{Binding IsNotMenu}" ColumnDefinitions="40,*" ColumnSpacing="14">
                <ImageButton
                    Command="{Binding BackToMenuCommand}"
                    Source="nav_back.png"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="10"
                    CornerRadius="12"
                    Background="{StaticResource PrimaryGradient}"
                    SemanticProperties.Description="{localization:Translate Key='Voltar para ajustes'}" />
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label
                        Text="{Binding AccountStatus}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Label
                        Text="{Binding SectionTitle}"
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsMenu}" Spacing="12">
                <Label
                    Text="{localization:Translate Key='Personalize sua experiência'}"
                    FontFamily="OpenSansSemibold"
                    FontSize="18"
                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <acrylic:AcrylicView Style="{StaticResource AcrylicCard}" Padding="14" MinimumHeightRequest="138">
                        <acrylic:AcrylicView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="account" />
                        </acrylic:AcrylicView.GestureRecognizers>
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Background="{StaticResource PrimaryGradient}">

                                <Image Source="settings_account.png" />
                            </Border>

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="{localization:Translate Key='Conta'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15" />

                                <Label
                                    Text="{localization:Translate Key='Seus dados e perfil'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </acrylic:AcrylicView>
                    <acrylic:AcrylicView Grid.Column="1"
                            Style="{StaticResource AcrylicCard}"
                            Padding="14"
                            MinimumHeightRequest="138">

                        <acrylic:AcrylicView.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="premium" />

                        </acrylic:AcrylicView.GestureRecognizers>
                        <VerticalStackLayout
                            Spacing="10"
                            VerticalOptions="Center">

                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Background="{StaticResource PrimaryGradient}">

                                <Image Source="settings_premium.png" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="{localization:Translate Key='Premium'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15" />

                                <Label
                                    Text="{localization:Translate Key='Planos e benefícios'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </acrylic:AcrylicView>
                    <acrylic:AcrylicView
                        Grid.Row="1"
                        Style="{StaticResource AcrylicCard}"
                        Padding="14"
                        MinimumHeightRequest="138">

                        <acrylic:AcrylicView.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="notifications" />

                        </acrylic:AcrylicView.GestureRecognizers>
                        <VerticalStackLayout
                            Spacing="10"
                            VerticalOptions="Center">

                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Background="{StaticResource PrimaryGradient}">

                                <Image Source="settings_notifications.png" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="{localization:Translate Key='Notificações'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15" />

                                <Label
                                    Text="{localization:Translate Key='Lembretes de leitura'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </acrylic:AcrylicView>
                    <acrylic:AcrylicView
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource AcrylicCard}"
                        Padding="14"
                         MinimumHeightRequest="138">

                        <acrylic:AcrylicView.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="theme" />

                        </acrylic:AcrylicView.GestureRecognizers>
                        <VerticalStackLayout
                            Spacing="10"
                            VerticalOptions="Center">

                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Background="{StaticResource PrimaryGradient}">

                                <Image Source="settings_theme.png" />

                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="{localization:Translate Key='Aparência'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15" />

                                <Label
                                    Text="{localization:Translate Key='Tema'}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </acrylic:AcrylicView>
                </Grid>
            </VerticalStackLayout>

            <Grid IsVisible="{Binding IsAccountSection}">
                <acrylic:AcrylicView Style="{StaticResource AcrylicCard}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Key='SEUS DADOS'}"
                        FontFamily="OpenSansSemibold"
                        FontSize="11"
                        CharacterSpacing="1.5"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                    <Label
                        Text="{localization:Translate Key='Veja e atualize as informações da sua conta.'}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                    <Label
                        Text="{localization:Translate Key='Entre ou crie uma conta para cadastrar e editar seu perfil.'}"
                        IsVisible="{Binding IsGuest}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                    <Border Style="{StaticResource GlassInputBorder}">

                        <controls:ModernEntry Placeholder="{localization:Translate Key='Nome'}" Text="{Binding FirstName}" MaxLength="100" IsEnabled="{Binding CanEditProfile}" />
                    </Border>
                    <Border Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='Sobrenome'}" Text="{Binding LastName}" MaxLength="100" IsEnabled="{Binding CanEditProfile}" />
                    </Border>
                    <Border Style="{StaticResource GlassInputBorder}" Padding="8,0">
                        <controls:ModernPicker Title="{localization:Translate Key='Função no Corpo de Cristo'}" ItemsSource="{Binding MinistryRoles}"
                                SelectedItem="{Binding MinistryRole}" IsEnabled="{Binding CanEditProfile}" />
                    </Border>
                    <Border Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='Telefone'}" Keyboard="Telephone" Text="{Binding Phone}" MaxLength="32" IsEnabled="{Binding CanEditProfile}" />
                    </Border>
                    <Border Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='E-mail'}" Keyboard="Email" Text="{Binding Email}" IsEnabled="False" />
                    </Border>
                    <Button Text="{localization:Translate Key='Salvar perfil'}" Command="{Binding SaveProfileCommand}" IsVisible="{Binding IsAccount}" />
                    <Button Text="{localization:Translate Key='Entrar ou criar conta'}" Command="{Binding SignInCommand}" IsVisible="{Binding IsGuest}" />
                    <Button Text="{localization:Translate Key='Sair da conta'}" Command="{Binding SignOutCommand}" IsVisible="{Binding IsAccount}"
                            Background="{StaticResource DangerButton}" TextColor="#FFFFFF" />
                    </VerticalStackLayout>
                </acrylic:AcrylicView>
            </Grid>

            <Grid IsVisible="{Binding IsPremiumSection}">
                <acrylic:AcrylicView Style="{StaticResource AcrylicCard}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{localization:Translate Key='ESCOLHA SEU PLANO'}" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.5"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label Text="{localization:Translate Key='Desbloqueie planos de leitura, anotações e personalização completa de notificações.'}"
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Border Background="{AppThemeBinding Light={StaticResource GlassSurfaceLight}, Dark={StaticResource GlassSurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                            StrokeShape="RoundRectangle 16" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{localization:Translate Key='Mensal'}" FontFamily="OpenSansSemibold" FontSize="17" />
                                <Label Text="{Binding MonthlyPrice}" FontSize="14" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{localization:Translate Key='Escolher'}" Command="{Binding PurchasePlanCommand}"
                                    CommandParameter="mensal" Padding="14,10" MinimumHeightRequest="44" />
                        </Grid>
                    </Border>
                    <Border Background="{AppThemeBinding Light={StaticResource GlassSurfaceLight}, Dark={StaticResource GlassSurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                            StrokeShape="RoundRectangle 16" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{localization:Translate Key='Semestral'}" FontFamily="OpenSansSemibold" FontSize="17" />
                                <Label Text="{Binding SemiAnnualPrice}" FontSize="14" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{localization:Translate Key='Escolher'}" Command="{Binding PurchasePlanCommand}"
                                    CommandParameter="semestral" Padding="14,10" MinimumHeightRequest="44" />
                        </Grid>
                    </Border>
                    <Border Background="{AppThemeBinding Light={StaticResource GlassSurfaceLight}, Dark={StaticResource GlassSurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                            StrokeShape="RoundRectangle 16" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{localization:Translate Key='Anual'}" FontFamily="OpenSansSemibold" FontSize="17" />
                                <Label Text="{Binding AnnualPrice}" FontSize="14" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{localization:Translate Key='Escolher'}" Command="{Binding PurchasePlanCommand}"
                                    CommandParameter="anual" Padding="14,10" MinimumHeightRequest="44" />
                        </Grid>
                    </Border>
                    <Label Text="{localization:Translate Key='A contratação ainda não está ativa. Nenhuma cobrança será feita até a integração de pagamento.'}"
                           FontSize="13" LineHeight="1.25"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Button Text="{localization:Translate Key='Criar conta'}" Command="{Binding CreateAccountCommand}" IsVisible="{Binding IsGuest}" />
                    <Label Text="{localization:Translate Key='Prévia de demonstração — não é uma compra nem uma assinatura.'}"
                           IsVisible="{Binding IsAccount}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Button Text="{localization:Translate Key='Ativar prévia Premium neste aparelho'}" Command="{Binding TogglePremiumPreviewCommand}"
                            IsVisible="{Binding CanEnablePremiumPreview}" Background="{StaticResource PrimaryGradient}"
                            TextColor="{StaticResource OnPrimary}" />
                    <Button Text="{localization:Translate Key='Desativar prévia Premium'}" Command="{Binding TogglePremiumPreviewCommand}"
                            IsVisible="{Binding CanDisablePremiumPreview}" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>
                </acrylic:AcrylicView>
            </Grid>

            <Grid IsVisible="{Binding IsNotificationsSection}">
                <acrylic:AcrylicView Style="{StaticResource AcrylicCard}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{localization:Translate Key='NOTIFICAÇÕES'}" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.5"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label Text="{localization:Translate Key='Visitantes não podem configurar notificações. Contas gratuitas podem alterar somente os horários dos dois lembretes padrão.'}"
                           FontSize="13" LineHeight="1.25"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Label Text="{localization:Translate Key='Entre ou crie uma conta para configurar os horários dos lembretes padrão.'}"
                           IsVisible="{Binding IsGuest}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Button Text="{localization:Translate Key='Entrar ou criar conta'}" Command="{Binding SignInCommand}" IsVisible="{Binding IsGuest}" />
                    <Border IsVisible="{Binding IsNotPremium}" Style="{StaticResource GlassInputBorder}" Padding="8,0">
                        <controls:ModernPicker Title="{localization:Translate Key='Selecione um lembrete'}" ItemsSource="{Binding Reminders}"
                                ItemDisplayBinding="{Binding Title}" SelectedItem="{Binding SelectedReminder}"
                                BackgroundColor="Transparent" />
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding IsPremium}" Spacing="8">
                        <Label Text="{localization:Translate Key='SEUS LEMBRETES'}" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.5"
                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reminders}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PrayerReminder">
                                    <acrylic:AcrylicView Style="{StaticResource AcrylicCard}" Padding="12">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" />
                                            <Label Grid.Column="1" Text="{Binding TimeLabel}" FontFamily="OpenSansSemibold" FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                                <Button Text="{localization:Translate Key='Editar'}" WidthRequest="64" HeightRequest="38"
                                                        Padding="0" MinimumHeightRequest="38" FontSize="12"
                                                        Command="{Binding BindingContext.EditReminderCommand, Source={x:Reference PageRoot}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="{localization:Translate Key='Excluir'}" WidthRequest="64" HeightRequest="38"
                                                        Padding="0" MinimumHeightRequest="38" FontSize="12"
                                                        Background="{StaticResource DangerButton}" TextColor="{StaticResource OnPrimary}"
                                                        Command="{Binding BindingContext.DeleteReminderCommand, Source={x:Reference PageRoot}}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </acrylic:AcrylicView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Border IsVisible="{Binding IsNotPremium}" Style="{StaticResource GlassInputBorder}" Padding="8,0">
                        <TimePicker Time="{Binding SelectedReminderTime}" IsEnabled="{Binding CanChangeReminderTime}"
                                    BackgroundColor="Transparent" />
                    </Border>
                    <Button Text="{Binding ReminderSaveButtonText}" Command="{Binding SaveReminderCommand}"
                            IsEnabled="{Binding CanChangeReminderTime}" IsVisible="{Binding IsNotPremium}" />
                    <Button Text="{localization:Translate Key='Ativar notificações neste aparelho'}" Command="{Binding EnableNotificationsCommand}"
                            IsEnabled="{Binding IsAccount}" IsVisible="{Binding IsAccount}"
                            Background="{StaticResource PrimaryGradient}" TextColor="{StaticResource OnPrimary}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <Label Text="{localization:Translate Key='Personalizar, criar ou excluir lembretes é exclusivo do Premium.'}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label Text="{Binding EditingReminderTitle}"
                           IsVisible="{Binding IsPremium}"
                           FontFamily="OpenSansSemibold"
                           FontSize="11"
                           CharacterSpacing="1.2"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Border IsVisible="{Binding IsPremium}" Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='Título'}" Text="{Binding ReminderTitle}" MaxLength="100" IsEnabled="{Binding CanManagePremiumPreferences}" />
                    </Border>
                    <Border IsVisible="{Binding IsPremium}" Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='Mensagem'}" Text="{Binding ReminderMessage}" MaxLength="1000" IsEnabled="{Binding CanManagePremiumPreferences}" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsPremium}">
                        <Border Style="{StaticResource GlassInputBorder}" Padding="8,0">
                            <TimePicker Time="{Binding SelectedReminderTime}" BackgroundColor="Transparent" />
                        </Border>
                        <Switch Grid.Column="1" IsToggled="{Binding SelectedReminderEnabled}" />
                    </Grid>
                    <Button Text="{localization:Translate Key='Salvar alterações do lembrete'}" Command="{Binding SaveReminderCommand}"
                            IsVisible="{Binding IsPremium}" />
                    <Border IsVisible="{Binding IsPremium}" Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='Novo título'}" Text="{Binding NewReminderTitle}" MaxLength="100"
                               IsEnabled="{Binding CanManagePremiumPreferences}" />
                    </Border>
                    <Border IsVisible="{Binding IsPremium}" Style="{StaticResource GlassInputBorder}">
                        <controls:ModernEntry Placeholder="{localization:Translate Key='Nova mensagem'}" Text="{Binding NewReminderMessage}" MaxLength="1000"
                               IsEnabled="{Binding CanManagePremiumPreferences}" />
                    </Border>
                    <Border IsVisible="{Binding IsPremium}" Style="{StaticResource GlassInputBorder}" Padding="8,0">
                        <TimePicker Time="{Binding NewReminderTime}" IsEnabled="{Binding CanManagePremiumPreferences}"
                                    BackgroundColor="Transparent" />
                    </Border>
                    <Button Text="{localization:Translate Key='Criar lembrete'}" Command="{Binding AddReminderCommand}"
                            IsVisible="{Binding IsPremium}" />
                    <Button Text="{localization:Translate Key='Conhecer planos Premium'}" Command="{Binding UpgradeCommand}"
                            IsVisible="{Binding IsNotPremium}" Background="{StaticResource PrimaryGradient}" TextColor="{StaticResource OnPrimary}" />
                    </VerticalStackLayout>
                </acrylic:AcrylicView>
            </Grid>

            <Grid IsVisible="{Binding IsThemeSection}">
                <acrylic:AcrylicView Style="{StaticResource AcrylicCard}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{localization:Translate Key='APARÊNCIA'}" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.5"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label Text="{localization:Translate Key='Use o tema do aparelho ou escolha claro ou escuro. A opção Sistema acompanha a configuração atual do celular.'}"
                           FontSize="14" LineHeight="1.25"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Border Style="{StaticResource GlassInputBorder}" Padding="8,0">
                        <controls:ModernPicker Title="{localization:Translate Key='Tema'}" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                BackgroundColor="Transparent" />
                    </Border>
                    <Button Text="{localization:Translate Key='Aplicar tema'}" Command="{Binding SaveThemeCommand}" />
                    </VerticalStackLayout>
                </acrylic:AcrylicView>
            </Grid>

            <Label Text="{Binding InfoMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   FontSize="13" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
        <controls:FloatingTabBar Grid.Row="1" SelectedTab="settings" />
    </Grid>
</ContentPage>
