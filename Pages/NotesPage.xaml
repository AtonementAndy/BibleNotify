<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BibleNotify.Pages.NotesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:acrylic="clr-namespace:Xe.AcrylicView;assembly=Xe.AcrylicView"
    xmlns:controls="clr-namespace:BibleNotify.Controls"
    xmlns:localization="clr-namespace:BibleNotify.Localization"
    xmlns:models="clr-namespace:BibleNotify.Data.Models"
    xmlns:vm="clr-namespace:BibleNotify.ViewModels"
    x:DataType="vm:NotesViewModel"
    Title="{localization:Translate Key='Anotações'}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}">

    <Grid RowDefinitions="*,Auto"
          Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <Grid Grid.Row="0" Padding="8,14,8,10" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Spacing="6">
            <Label
                Text="{localization:Translate Key='Guarde o que tocou você.'}"
                FontFamily="OpenSansSemibold"
                FontSize="26"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="{localization:Translate Key='Organize e releia suas reflexões bíblicas.'}"
                FontSize="14"
                TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="16">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding NoteFormTitle}" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.5"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                <VerticalStackLayout Spacing="10" IsEnabled="{Binding IsPremium}" Opacity="{Binding FormOpacity}">
                    <Grid ColumnDefinitions="*,82,82" ColumnSpacing="8">
                        <Border Style="{StaticResource GlassInputBorder}" Padding="8,0">
                            <controls:ModernPicker
                                Title="{localization:Translate Key='Livro'}"
                                ItemsSource="{Binding Books}"
                                SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding Name}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource GlassInputBorder}" Padding="6,0">
                            <controls:ModernEntry Placeholder="{localization:Translate Key='Cap.'}" Keyboard="Numeric" Text="{Binding SelectedChapter}" HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource GlassInputBorder}" Padding="6,0">
                            <controls:ModernEntry Placeholder="{localization:Translate Key='Vers.'}" Keyboard="Numeric" Text="{Binding SelectedVerse}" HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border Padding="12"
                            Shadow="{x:Null}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource GlassInputLight}, Dark={StaticResource GlassInputDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 18">
                        <controls:ModernEditor
                            Placeholder="{localization:Translate Key='Escreva sua reflexão...'}"
                            Text="{Binding NoteText}"
                            MaxLength="10000"
                            Keyboard="Text"
                            IsSpellCheckEnabled="True"
                            IsTextPredictionEnabled="True"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="90" />
                    </Border>
                    <Button
                        Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsPremium}" />
                    <Button
                        Text="{localization:Translate Key='Cancelar edição'}"
                        Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding IsEditingNote}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsLocked}" Spacing="8">
                    <Label
                        Text="{localization:Translate Key='🔒 ANOTAÇÕES EXCLUSIVAS DO PREMIUM'}"
                        FontFamily="OpenSansSemibold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label
                        Text="{Binding AccessMessage}"
                        FontSize="13"
                        LineHeight="1.25"
                        TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Button Text="{Binding AccountGateButtonText}" Command="{Binding ContinueFromGateCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding NoteGroups}"
            IsGrouped="True"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label
                    Text="{Binding EmptyNotesMessage}"
                    Padding="4,20"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:BibleNoteGroup">
                    <Label
                        Text="{Binding BookName}"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        Padding="4,8"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BibleNote">
                    <Border
                        Style="{StaticResource ElevatedCard}"
                        Margin="0,0,0,12"
                        Padding="16">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <Label
                                Text="{Binding Reference}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding UpdatedDateLabel}"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding Text}"
                                FontSize="15" />
                            <HorizontalStackLayout
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="End"
                                Spacing="8">
                                <Button
                                    Text="{localization:Translate Key='Editar'}"
                                    Command="{Binding BindingContext.EditCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}"
                                    WidthRequest="72"
                                    HeightRequest="40"
                                    Padding="0"
                                    MinimumHeightRequest="40"
                                    FontSize="12" />
                                <Button
                                    Text="{localization:Translate Key='Excluir'}"
                                    Command="{Binding BindingContext.DeleteCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}"
                                    WidthRequest="72"
                                    HeightRequest="40"
                                    Padding="0"
                                    MinimumHeightRequest="40"
                                    FontSize="12"
                                    Background="{StaticResource DangerButton}"
                                    TextColor="#FFFFFF" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="3"
            Text="{Binding ErrorMessage}"
            TextColor="{StaticResource Error}"
            FontSize="13" />
    </Grid>
        <controls:FloatingTabBar Grid.Row="1" SelectedTab="notes" />
    </Grid>
</ContentPage>
